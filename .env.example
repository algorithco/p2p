# Host env for docker compose — NEVER commit (git-ignored via *.env).
# POSTGRES_PASSWORD is REQUIRED (compose fail-fasts with :? if unset).
# Generate a strong secret per deployment:
#   openssl rand -base64 32
# Then:
#   echo "POSTGRES_PASSWORD=<output>" > .env
#   chmod 600 .env
# Rotation on an existing volume: ALTER USER escrow WITH PASSWORD '...' inside
# postgres first, then update .env to match.
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
