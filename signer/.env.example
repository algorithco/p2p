# =============================================================================
#  SIGNER — W5 TON Wallet (V5R1)
#  - Never commit a real .env. signer/.env is git-ignored.
#  - Mnemonic controls real funds; keep 600 perms, rotate if leaked.
# =============================================================================

# 24-word BIP39 phrase, space-separated. REQUIRED for signing.
# Generate securely: https://iancoleman.io/bip39/ or via script.
SIGNER_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24

# Internal API key for backend → signer auth (32+ random chars). REQUIRED in prod.
# Generate: PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
SIGNER_API_KEY=change_me_32plus_random_chars

# TON network
TON_NETWORK=testnet
# TONCENTER endpoint override (optional). If empty, derived from TON_NETWORK.
TON_API_ENDPOINT=
TONCENTER_API_KEY=

# HTTP port (inside container)
PORT=3001
# Optional: restrict CORS origin (empty = allow internal only)
CORS_ORIGIN=

# Optional: wallet workchain (default 0; only 0 or -1 are valid, else 0)
WALLET_WORKCHAIN=0

# Optional per-transfer TON cap in human units (e.g. "50"). Unset/0 = unlimited.
# Defense-in-depth against key-compromise drain + testnet safety net.
# Applies to /send, /send-batch (per message), /deploy, /deploy-escrow.
# MAX_SEND_TON=

# Durable idempotency (recommended): shared Postgres so a signer restart cannot
# lose dedupe tracking. Same DB as backend (compose overrides with service host).
# If empty, idempotency is memory-only (restart loses the 24h dedupe window).
# DATABASE_URL=postgres://escrow:CHANGE_ME_STRONG_RANDOM@localhost:5432/escrow
