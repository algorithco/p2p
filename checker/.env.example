# Standalone checker env (git-ignored, never commit real values).
# HTTP port for the checker API.
PORT=3004
# TON network: mainnet | testnet (gifts/usernames live on mainnet).
TON_NETWORK=mainnet
# TON jsonRPC endpoint. Leave empty to derive from TON_NETWORK.
# Mainnet default: https://toncenter.com/api/v2/jsonRPC
TON_API_ENDPOINT=
# Optional but strongly recommended (keyless toncenter throttles hard: HTTP 429).
# Free key: https://toncenter.com/ — checker AND backend both need it.
TONCENTER_API_KEY=
# TonAPI key for seller-wallet NFT enumeration (gift lookup).
# Free key: https://tonconsole.com/
TONAPI_KEY=
# Optional: getgems public API key (extended access).
GETGEMS_API_KEY=
# Telegram bot token — only for Bot API gift binding (getUserGifts).
BOT_TOKEN=
# Postgres for owner bindings (checker_owners table only).
# Leave empty to run without persistence (save endpoints return 503).
DATABASE_URL=
# Optional overrides (auto-discovered on-chain if empty).
# Root DNS contract address (else read from blockchain config param #4).
DNS_ROOT_ADDRESS=
# .t.me resolver/collection address (else discovered via root DNS).
TME_RESOLVER_ADDRESS=
