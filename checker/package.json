{
  "name": "escrow-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone NFT ownership checker (TON NFTs, .t.me usernames, Telegram gift collectibles). Read-only verification service on :3004.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "ts-node --files src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ton/core": "^0.63.1",
    "@ton/ton": "^16.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "pg": "^8.11.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.17",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.10.0",
    "ts-node": "^10.9.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
