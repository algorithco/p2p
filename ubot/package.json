{
  "name": "ubot",
  "version": "1.0.0",
  "description": "Robust Telegram userbot for channel/group takeover (ownership/admin transfer)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "login": "ts-node scripts/login.ts",
    "login:verbose": "ts-node scripts/login-verbose.ts",
    "login:qr": "ts-node scripts/login-qr.ts"
  },
  "dependencies": {
    "bottleneck": "^2.19.5",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "qrcode-terminal": "^0.12.0",
    "teleproto": "^1.229.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.17",
    "@types/node": "^26.5.1",
    "ts-node": "^10.9.0",
    "typescript": "7.0.2",
    "vitest": "3.2.4",
    "zod": "^3.22.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
