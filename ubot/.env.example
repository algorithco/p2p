# =============================================================================
#  UBOT — Telegram Userbot (GramJS)
#  - Holds user account session. Never commit this file. chmod 600.
#  - Copy to .env and fill: cp .env.example .env
# =============================================================================

# Telegram API credentials from https://my.telegram.org (required)
API_ID=123456
API_HASH=<replace-me-with-32-hex-chars-from-my.telegram.org>

# Userbot session (StringSession). Generate via: npm run login or npm run login:qr
# Store encrypted: leave empty to login interactively on first run if ENCRYPTION_KEY set
# Supports both legacy raw base64 and new enc:v1: prefixed format (backward compat)
UBOT_SESSION_STRING=

# Phone number for initial login (E.164, e.g. +1234567890) — used by login script
UBOT_PHONE=

# 2FA password (if account has 2FA). Stored in env, never logged.
TWO_FA_PASSWORD=

# Encryption key for session at rest (32 bytes hex, 64 chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also accepts 64 bytes hex (128 chars) which is SHA256-hashed to 32 bytes.
# INDEPENDENT key: protects only ubot's own session file. It does NOT need to
# match backend/utradebot (unlike those two, which MUST share one value).
# Rotating? Send SIGHUP after changing ENCRYPTION_KEY to clear cache: kill -HUP <pid>
ENCRYPTION_KEY=

# Internal API
PORT=3002
UBOT_API_KEY=change_me_32plus_random_for_internal_auth # >=32 chars, 64 hex recommended

# Optional: Postgres for session persistence (alternative to file)
DATABASE_URL=postgres://escrow:escrow_password@postgres:5432/escrow

# Logging
LOG_LEVEL=info
NODE_ENV=development  # production enables isProduction optimizations

# -----------------------------------------------------------------------------
# Takeover & Rate Limit Tuning
# -----------------------------------------------------------------------------

# Cooldown between takeover attempts on same channel (hours) — prevents FloodWait spam
TAKEOVER_COOLDOWN_H=24

# Global Telegram rate limiting (ms between API calls via Bottleneck) — 1300 ms default avoids FloodWait
GLOBAL_RATE_MS=1300

# Cache TTL for channel/group info (seconds) — avoids repeated getEntity calls
CACHE_TTL_S=300

# Flood threshold for floodSleepThreshold (seconds) — teleproto will auto-sleep below this
FLOOD_THRESHOLD=60

# Human-like delays between actions (ms) — jitter to mimic real user, reduces ban risk
HUMAN_DELAY_MIN=800
HUMAN_DELAY_MAX=2500

# Per-minute caps to avoid PeerFlood / ban
MAX_PROMOTE_PER_MIN=10
MAX_TRANSFER_PER_MIN=2

# -----------------------------------------------------------------------------
# Telegram Client Spoofing (deviceModel etc. forwarded to Telegram)
# -----------------------------------------------------------------------------

DEVICE_MODEL=Pixel 7
SYSTEM_VERSION=14
APP_VERSION=10.2.1

# -----------------------------------------------------------------------------
# Proxy (optional)
# -----------------------------------------------------------------------------

# Optional HTTP/SOCKS proxy for Telegram connection — useful if DC is blocked
# teleproto respects SOCKS5/HTTP; examples:
# PROXY_URL=socks5://user:pass@127.0.0.1:1080
# PROXY_URL=http://127.0.0.1:8080
# HTTP_PROXY=socks5://127.0.0.1:1080
# HTTPS_PROXY=http://127.0.0.1:8080
# PROXY_URL=

# -----------------------------------------------------------------------------
# Warmup & Session Notes
# -----------------------------------------------------------------------------

# Warmup: on client connect ubot runs iterDialogs({limit:5}) + humanDelay to ensure
# session is fully ready and avoid cold-start FloodWait. Disable only for debugging:
# WARMUP=true

# Session storage:
# - Encrypted at rest via AES-256-GCM (ENCRYPTION_KEY) with marker enc:v1: to avoid
#   1.5% collision where raw encrypted base64 could start with '1' like plaintext.
# - File: ./sessions/ubot.session.enc (chmod 600, atomic write)
# - Env: UBOT_SESSION_STRING takes priority over file; supports both enc:v1: and legacy raw base64
# - Rotation: after changing ENCRYPTION_KEY, do kill -HUP <pid> or restart to clear key cache
