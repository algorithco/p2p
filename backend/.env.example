# =============================================================================
#  SECURITY BANNER
#  - Never commit a real .env. backend/.env is git-ignored on purpose.
#  - If ANY token/key below was ever committed or leaked: ROTATE IT NOW
#    (@BotFather for BOT_TOKEN, new API_KEY, etc.).
#  - Wallet keys live ONLY in signer/.env (SIGNER_MNEMONIC, W5). Backend
#    never holds mnemonics — it talks to signer via SIGNER_URL + SIGNER_API_KEY.
#    Keep signer balance minimal + cold storage for rest.
# =============================================================================

# --- Telegram bot -----------------------------------------------------------
# Token from @BotFather. Without it the bot polling is disabled (API still runs).
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Bot username (without @) — used for t.me deep links and the menu button.
BOT_USERNAME=savdochi_uzbot
# Comma-separated Telegram user ids with admin rights.
ADMIN_TELEGRAM_IDS=111111,222222

# --- Database ---------------------------------------------------------------
# NEVER use a weak password here. Generate a strong one per deployment:
#   openssl rand -base64 32
# Local dev placeholder only — replace before any shared/prod use.
DATABASE_URL=postgres://escrow:CHANGE_ME_STRONG_RANDOM@localhost:5432/escrow
# HTTP port for the Express API (default 3000 if unset; docker-compose sets 3000).
PORT=3000

# --- TON network ------------------------------------------------------------
# TON API v2 endpoint. Code default: https://tonapi.io.
# For toncenter use: https://toncenter.com/api/v2/jsonRPC
TON_API_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
# testnet | mainnet (code default: mainnet)
TON_NETWORK=testnet
# Optional but strongly recommended in prod (rate limits otherwise apply).
TONCENTER_API_KEY=

# --- Signer microservice (W5 wallet) -----------------------------------------
# W5 wallet keys live ONLY in signer/.env (SIGNER_MNEMONIC). Backend never sees them.
# URL of the signer service (internal docker network default)
SIGNER_URL=http://signer:3001
# Must match SIGNER_API_KEY in signer/.env
SIGNER_API_KEY=change_me_32plus_random_chars

# --- Escrow contract (LEGACY — no on-chain contract in this repo) -----------------
# ESCROW_CONTRACT_CODE_HEX is an unused legacy stub (compiled Tact BOC hex was
# never committed). Leave empty. Custody is entirely off-chain in the signer
# W5 wallet; Postgres is the source of truth.
ESCROW_CONTRACT_CODE_HEX=
# Jetton master of the asset used for jetton deals (e.g. USDT master).
# REQUIRED for USDT anti-forgery: the deposit listener verifies jetton
# notifications arrive from this master's derived wallet. While unset, any
# fake-master notification with the right memo+amount can confirm a deposit.
JETTON_MASTER_ADDRESS=
# Canonical USDT jetton address on TON.
USDT_JETTON_ADDRESS=
# Decimal string of the jetton wallet code hash used to derive wallets.
JETTON_WALLET_CODE_HASH=0

# --- Fees & policy -----------------------------------------------------------
# Fee collector address (TON/friendly format).
FEE_ADDRESS=
# Fee in basis points: 100 = 1% (code default 100).
FEE_BPS=100
# LEGACY alias kept for compatibility; percent, code default 1. Prefer FEE_BPS.
FEE_PERCENTAGE=1
# Network confirmations required before a deposit counts (code default 3).
MIN_CONFIRMATIONS=3

# --- Addresses -----------------------------------------------------------------
# Admin/arbiter address passed into escrow contracts (can release/refund).
ADMIN_ADDRESS=
# Deployer wallet address (W5). Derived automatically from signer; set manually
# only for off-chain / read-only mode or to override auto-discovery.
WALLET_ADDRESS=

# --- Mode switches -------------------------------------------------------------
# Custodial off-chain is the only supported mode (default false).
# REQUIRE_ONCHAIN=true is legacy: it does NOT enable on-chain escrow, it only
# makes GET /api/status/:address attempt an on-chain read.
REQUIRE_ONCHAIN=false

# --- Mini App / webapp (micro-architecture: frontend separate) -------------------
# Frontend (nginx) service URL — where the Telegram Mini App is hosted.
# In docker-compose: frontend:80 -> host:8080, backend:3000 API-only.
# For local dev without docker: frontend at http://localhost:8080, backend at http://localhost:3000
FRONTEND_URL=http://localhost:8080
# Public HTTPS URL of the Telegram Mini App. Required for the bot menu button
# ("Open App") and join links. For Telegram, this must be https (not localhost).
# Set to https://your-domain in production; falls back to FRONTEND_URL if empty.
WEBAPP_URL=https://your-twa-domain.example
# Set to true to make backend also serve webapp/public (dev fallback when frontend not running)
SERVE_STATIC=false

# --- Chat E2E encryption ---------------------------------------------------------
# Master key for at-rest + per-deal key wrapping (AES-256-GCM). MUST be 64 hex chars (32 bytes).
# Generate:  openssl rand -hex 32
# PowerShell: -join (0..31 | ForEach-Object { "{0:X2}" -f (Get-Random -Minimum 0 -Maximum 256) })
# Keep same across restarts; must be set in production for seller-buyer chat to be fully encrypted at rest.
# SHARING RULE: use the SAME value here and in utradebot/.env (backend writes
# utrade_trades.session_encrypted, utradebot decrypts it — mismatched keys break
# webapp-created trades). ubot's key is independent.
# REQUIRED: boot exits(1) without a valid key (fail-closed, no plaintext fallback).
ENCRYPTION_KEY=<replace-me-64-hex-chars-openssl-rand-hex-32>

# --- API auth --------------------------------------------------------------------
# Legacy operator header (sent as x-api-key). NOTE (2026-09): grants NO identity
# and NO admin rights — verified x-init-data is required for user routes,
# ADMIN_API_KEY for admin routes. No internal microservice uses this key
# (signer/ubot/utradebot each have their own distinct keys below). Keep set so
# requireIdentity stays enforced; leave EMPTY only for local development.
# Generate 32+ random chars:
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
API_KEY=
# Admin-scoped API key for release/refund and admin-only endpoints (P0-2). Distinct from
# API_KEY — a leaked generic service key must NOT grant admin. Set a separate 32+ random
# value and use ONLY for trusted admin tooling via x-admin-api-key header.
# Generic callers presenting API_KEY (x-api-key) will be 403 on POST /api/withdraw,
# POST /api/refund, POST /api/notify, GET /api/notifications, GET /api/admin/*.
# ADMIN_API_KEY must be sent as x-admin-api-key (no fallback to x-api-key).
# ADMIN_API_KEY=
# Dev-only identity fallback: when true AND BOT_TOKEN+API_KEY are unset (and never
# in production), the backend trusts x-telegram-user-id for local testing.
# ALLOW_DEV_AUTH=false

# --- Internal microservices (proxied by backend) --------------------------------
# Ubot (channel/group custody) endpoint + key (backend -> ubot x-api-key).
# UBOT_URL=http://ubot:3002
# UBOT_API_KEY=
# Utradebot (account-sale handoff) endpoint + key (backend -> utradebot x-api-key).
# UTRADE_URL=http://utradebot:3003
# UTRADE_API_KEY=
